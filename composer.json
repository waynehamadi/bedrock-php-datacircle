{
  "name": "datacircle/bedrock-tools",
  "description": "Find the best GTM APIs. Four tools for Amazon Bedrock's Converse API in the AWS SDK for PHP. The tools call Datacircle's public API. You need no API key.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://datacircle.dev",
  "keywords": [
    "bedrock",
    "amazon-bedrock",
    "aws",
    "aws-sdk-php",
    "converse",
    "tool-use",
    "tool-calling",
    "tools",
    "api",
    "gtm",
    "datacircle"
  ],
  "authors": [
    {
      "name": "Wayne Hamadi",
      "email": "wayne@datacircle.dev",
      "homepage": "https://datacircle.dev"
    }
  ],
  "support": {
    "issues": "https://github.com/waynehamadi/bedrock-php-datacircle/issues",
    "source": "https://github.com/waynehamadi/bedrock-php-datacircle",
    "docs": "https://datacircle.dev/api"
  },
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "aws/aws-sdk-php": "^3.371.4",
    "guzzlehttp/guzzle": "^7.4.5 || ^8.0",
    "guzzlehttp/psr7": "^2.4.5 || ^3.0",
    "psr/http-client": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Datacircle\\Bedrock\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Datacircle\\Bedrock\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
